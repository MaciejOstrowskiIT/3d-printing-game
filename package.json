{
  "name": "drukarnia",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:qa": "tsc --noEmit && vite build --mode qa --outDir dist-qa",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist-crazygames",
    "build:poki": "tsc --noEmit && vite build --mode poki --outDir dist-poki",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:layout": "playwright test e2e/layout.spec.ts",
    "typecheck": "tsc --noEmit",
    "promo": "npm run build && vite-node promo/snapshots.ts && python3 promo/render.py && python3 promo/video.py"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@preact/signals": "^2.0.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@preact/preset-vite": "^2.9.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
