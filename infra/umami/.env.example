# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
APP_SECRET=change-me
# Optional: rename the collect path (also set VITE_UMAMI_ENDPOINT in the game build to the same value)
COLLECT_API_ENDPOINT=/api/send
UMAMI_PORT=3000
# Only for the "tunnel" profile: token from Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
